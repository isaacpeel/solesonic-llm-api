# Environment variables for izzy-bot-api
# Replace these placeholder values with your actual values

# Database configuration
DB_PASSWORD=your database password here
POSTGRES_USER=your postgres username here
POSTGRES_DB=your postgres database name here

# Feature flags
TRAINING_ENABLED=false
CONFLUENCE_TRAINING_ENABLED=false

# Security configuration
JWK_SET_URI=https://your-jwk-set-uri
ISSUER_URI=https://your-issuer-uri

# Jira API configuration
JIRA_CLIENT_ID=your_jira_client_id
JIRA_CLIENT_SECRET=your_jira_client_secret

# SSL configuration
KEYSTORE_PASSWORD=your_keystore_password

# Push notifications (Chrome Web Push). Generate the VAPID pair once: npx web-push generate-vapid-keys
PUSH_ENABLED=true
PUSH_VAPID_PUBLIC_KEY=your_base64url_vapid_public_key
PUSH_VAPID_PRIVATE_KEY=your_base64url_vapid_private_key
PUSH_VAPID_SUBJECT=mailto:you@example.com
PUSH_ALLOWED_ENDPOINT_HOSTS=fcm.googleapis.com
PUSH_CONNECT_TIMEOUT=5s
PUSH_READ_TIMEOUT=10s
PUSH_MAX_ATTEMPTS=3
PUSH_MAX_FAILURES=5
PUSH_ELICITATION_REMINDER_SECONDS=120
PUSH_PRESENCE_TTL_SECONDS=45
PUSH_PRESENCE_HEARTBEAT_SECONDS=15
