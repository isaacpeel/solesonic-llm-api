# Copy this file to .env and fill in real values. .env itself is gitignored; this file is not —
# never put real secrets or hostnames in .env.example.
#
# See docs/configuration.md for the full reference, including which variables are required per
# profile (local/test/prod/prod-nginx) and what each one does.

# Application Configuration
APPLICATION_NAME=solesonic-llm-api
BASE_URI=izzybot
BOT_NAME=Izzy Bot

# Database Configuration (required)
DB_URL=jdbc:postgresql://localhost:5432/solesonic-llm-api
POSTGRES_USER=solesonic-llm-api
DB_PASSWORD=change-me

# Security/JWT Configuration (required for prod; optional for local)
ISSUER_URI=https://your-issuer
JWK_SET_URI=https://your-issuer/protocol/openid-connect/certs
TOKEN_ENDPOINT=https://your-issuer/protocol/openid-connect/token

# Encryption Configuration (required)
ENCRYPTION_PASSWORD=change-me
ENCRYPTION_SALT=change-me

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Redis Configuration (local profile defaults to localhost:6379 with no password)
REDIS_HOST=localhost
REDIS_PASSWORD=change-me

# Model Server Configuration — six independently-configured OpenAI-compatible endpoints, one per
# interaction (chat, ETL, vision, embedding, RAG task, tool-call routing). Each is a full base URL
# including the /v1 path. All six are required; several may point at the same server while getting
# started. See docs/configuration.md#model-server-configuration.
CHAT_OPENAI_HOST=http://localhost:8080/v1

ETL_OPENAI_HOST=http://localhost:8080/v1
ETL_MODEL=llama3.1:8b

VISION_OPENAI_HOST=http://localhost:8080/v1
VISION_MODEL=qwen2.5vl

EMBEDDING_OPENAI_HOST=http://localhost:8080/v1
RAG_TASK_OPENAI_HOST=http://localhost:8080/v1
TOOL_CALL_OPENAI_HOST=http://localhost:8080/v1

# Image Generation (required)
IMAGE_MAX_CONCURRENT=2
IMAGE_ADMISSION_TIMEOUT=30s

# MCP Configuration
SOLESONIC_MCP_URI=http://localhost:8181
MCP_CLIENT_ID=your_mcp_client_id
MCP_CLIENT_SECRET=your_mcp_client_secret
MCP_ISSUER_URI=https://your-auth-server
A2A_BASE_URI=http://localhost:8181

# Atlassian Integration (optional — only needed if using Jira/Confluence features)
ATLASSIAN_OAUTH_CLIENT_ID=your_atlassian_client_id
ATLASSIAN_OAUTH_CLIENT_SECRET=your_atlassian_client_secret
ATLASSIAN_OAUTH_TOKEN_URI=https://auth.atlassian.com/oauth/token
JIRA_CLOUD_ID_PATH=/your-cloud-id
CALLBACK_HOST=https://yourdomain.com/settings
ATLASSIAN_TOKENS_ADMIN_KEY=your_admin_key

# Google Integration (optional — only needed if using Gmail features)
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
