flowchart TD
    INIT["PromptService constructor (once, at startup):\nbuild basic-prompt PromptTemplate\n(basicSystemPrompt resource + agentName)\n→ defaultSystemPrompt field"]

    U0["streamBasicPrompt(chatId, userId, message,\nattachmentContext, contextMap, model, capture)"]

    INIT -.->|"reused on every call"| U2

    U0 --> U2["chatClient.prompt()\n.system(defaultSystemPrompt.getContents())\n.user(message)"]

    U2 --> U3["attach RAG advisor\nvectorStoreService.retrievalAugmentationAdvisor(userId, chatId)\n+ advisor param CONVERSATION_ID = chatId"]

    U3 --> U4[".toolContext(contextMap)\n.options(chatOptions(model))\n→ streamUsage(true)"]

    U4 --> U5{"attachmentContext\nnon-empty?"}

    U5 -->|Yes| U6["promptSpec.messages(new UserMessage(attachmentContext))\ninserted between system and user message"]
    U5 -->|No| U7

    U6 --> U7["promptSpec.stream().chatResponse()"]

    U7 --> U8["RAG advisor chain runs:\nvector search + rewrites last user message\nwith retrieved context"]

    U8 --> U9["OpenAiChatModel opens SSE stream\nto CHAT_OPENAI_HOST (okhttp)"]

    U9 -->|chunks arrive| U10["MessageAggregator accumulates\nChatResponse chunks + usage"]
    U9 -->|"no bytes for read-timeout window"| ERR["okhttp read timeout\nSocketException: Socket closed\n→ OpenAIIoException: Stream failed\n→ MessageAggregator Aggregation Error"]

    U10 --> U11["contentFlux:\ncapture ResponseMetadata per chunk\nextract Generation text, filter empty"]

    U11 --> U12(["Flux&lt;String&gt; returned\n(consumed by SSE/Redis publish path)"])

